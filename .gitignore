# Staged as .gitignore. The monorepo's copy for this directory covers private
# artifacts (schema_docs, PII caches) that do not exist here, so the harness
# carries its own.

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/

# Provider credentials.
.env
.env.*
!.env.example

# Generated by the example: the chDB store (rewritten on every open, so a
# committed copy drifts) and the pipeline output (regenerating it is the point).
example/warehouse/
example/out/
